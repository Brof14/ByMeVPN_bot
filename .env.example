# ──────────────────────────────────────────────
# ByMeVPN Bot — environment variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Telegram Bot
BOT_TOKEN=
SUPPORT_USERNAME=@ByMeVPN_support_bot
MENU_PHOTO=https://example.com/menu.jpg
ADMIN_IDS=123456789

# Путь к файлу базы данных бота.
DB_FILE=data/vpnbot.db

# ============================================================
# 3x-ui Panel
# ============================================================

# XUI_URL — ПУБЛИЧНЫЙ адрес панели (используется в ссылках подписки для клиентов).
# Например: https://bymevpn.duckdns.org:2096
XUI_URL=https://your-server.com:2096

# XUI_API_URL — адрес, по которому БОТ обращается к REST API панели.
# Если бот и панель на одном сервере — используйте localhost:
#   XUI_API_URL=http://127.0.0.1:54321/secret-path
# Если бот на другой машине — укажите тот же адрес, что и XUI_URL.
XUI_API_URL=http://127.0.0.1:54321

XUI_USERNAME=admin
XUI_PASSWORD=your_panel_password
# Verify the 3x-ui HTTPS certificate. Set false only for intentional self-signed TLS.
XUI_TLS_VERIFY=true

# Explicitly list every inbound you intend to include in customer subscriptions.
# Replace this example with IDs that exist in YOUR panel; do not copy blindly.
XUI_INBOUND_IDS=2,3

# Путь подписки в панели (настраивается в 3x-ui → Настройки → Путь подписки)
XUI_SUB_PATH=sub

# ============================================================
# YooKassa
# ============================================================
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Crypto Bot (@send)
# ============================================================
CRYPTO_BOT_TOKEN=

# ============================================================
# Webhook
# ============================================================
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
# Keep the application bound to loopback. Publish the callback only through an HTTPS reverse proxy.
# Public callback URL example: https://your-domain.example/webhook/yookassa
# Do not expose TCP/8080 directly to the Internet; Telegram uses long polling.
# The reverse proxy/firewall must restrict access to official YooKassa source IP ranges.

# ============================================================
# Email (опционально)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASSWORD=your_smtp_password

# ============================================================
# Прочее
# ============================================================

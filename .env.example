# ──────────────────────────────────────────────
# ByMeVPN Bot — environment variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Telegram Bot
BOT_TOKEN=
# Use polling-only for a secondary bot that shares production data. Keep the
# primary instance as the only owner of webhook and background workers.
BOT_INSTANCE_MODE=primary
# Set to 1 only after confirming Telegram Premium on the bot owner account
# or an eligible Fragment username for the bot. Otherwise keep 0.
BOT_PREMIUM_BUTTON_ICONS=0
MENU_PHOTO=https://example.com/menu.jpg
ADMIN_IDS=123456789

# Путь к файлу базы данных бота.
DB_FILE=data/vpnbot.db
REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================
# 3x-ui Panel
# ============================================================

# XUI_URL — ПУБЛИЧНЫЙ адрес панели (используется в ссылках подписки для клиентов).
# Например: https://bymevpn.duckdns.org:2096
XUI_URL=https://your-server.com:2096

# XUI_API_URL — адрес REST API, доступный боту.
# Надёжный вариант: оставить пустым — бот возьмёт XUI_URL и проверит TLS-сертификат.
# Для localhost указывайте только реальный HTTP-порт панели/прокси и её base path.
# Не используйте https://127.0.0.1, если сертификат выдан на домен панели.
XUI_API_URL=

XUI_USERNAME=admin
XUI_PASSWORD=your_panel_password
# Verify the 3x-ui HTTPS certificate. Set false only for intentional self-signed TLS.
XUI_TLS_VERIFY=true

# Старое поле конфигурации (приложение использует фиксированные inbound 12,13,14,15)
XUI_INBOUND_IDS=12,13,14,15

# Путь подписки в панели (настраивается в 3x-ui → Настройки → Путь подписки)
XUI_SUB_PATH=sub

# ============================================================
# YooKassa
# ============================================================
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google sign-in stays closed unless the server flow is validated for release.
GOOGLE_SIGNIN_ENABLED=0
GOOGLE_WEB_CLIENT_ID=

# ============================================================
# Crypto Bot (@send)
# ============================================================
CRYPTO_BOT_TOKEN=

# ============================================================
# Webhook
# ============================================================
# Optional until signed mobile entitlements are deployed. The referenced file
# must be mounted read-only, root-owned, and mode 0400 or 0600. Never put PEM
# key material directly in this environment file.
MOBILE_ENTITLEMENT_ES256_PRIVATE_KEY_FILE=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Публичный адрес этого webhook/API сервера. Используется для страницы
# /app/login, которая открывает мобильное приложение по кнопке из бота.
APP_PUBLIC_URL=http://bymevpn.duckdns.org:8080
# Source networks allowed to call the YooKassa notification endpoint.
YOOKASSA_WEBHOOK_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
WEBHOOK_URL=https://your-server.com:8080/webhook/telegram

# ============================================================
# Email (опционально)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASSWORD=your_smtp_password

# ============================================================
# Прочее
# ============================================================

# Optional additional OAuth 2.0 Client ID, created as *Desktop app* in the
# SAME Google Cloud project as GOOGLE_WEB_CLIENT_ID. Public ID, not a secret.
# Required to enable Windows Google login using browser + localhost PKCE.
# NEVER put a Google OAuth client secret into the distributed application.
GOOGLE_DESKTOP_CLIENT_ID=
# Optional server-side PKCE code exchange for Windows Desktop OAuth.
# Set from the *Desktop app* credential JSON on VPS only. Never commit or
# distribute this value; Android still uses GOOGLE_WEB_CLIENT_ID.
# The desktop-client public endpoint reports server_code_exchange=true
# only when this environment variable is configured.
GOOGLE_DESKTOP_CLIENT_SECRET=

# Optional exact public ad post URL from @ByMeVPN. When unset, the bot links
# to the channel and asks users to find the original promotional post.
# No automatically composed ad text is accepted as a replacement.
AD_SOURCE_POST_URL=
